# Database
# For Neon pooler URLs, append: ?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/ulu_school?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:6543/ulu_school?schema=public"

# Runtime (normally set by Next.js / hosting platform)
RENDER=""
NODE_ENV="development"
APP_ENV=""
NEXT_RUNTIME=""

# Private object storage
STORAGE_DRIVER="local"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# SMTP (Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="ULU Online School <no-reply@uluglobalacademy.com>"
SCHOOL_INBOX_EMAIL="info@uluglobalacademy.com"
SMTP_MAX_RETRIES="3"

# Optional fallback (Gmail)
EMAIL_USER=""
EMAIL_PASS=""

# Privacy disclosures
PRIVACY_CONTACT_EMAIL="info@uluglobalacademy.com"
PRIVACY_EMAIL_PROCESSOR_NAME=""

# Form Security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ENFORCE="false"
MIN_FORM_FILL_MS="1200"
ENROL_FORM_MAX_REQUESTS="5"
ENROL_FORM_WINDOW_MS="600000"
CONTACT_FORM_MAX_REQUESTS="8"
CONTACT_FORM_WINDOW_MS="600000"

# Auth / Portal
AUTH_SESSION_SECRET="change-this-session-secret"
SEED_PORTAL_PASSWORD="ChangeMe123!"
# Production bootstrap: leave all three empty once an active administrator exists.
# Otherwise set all three values and run `npm run bootstrap:production` after migrations.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
ADMIN_REQUIRE_2FA="true"
ADMIN_2FA_SECRET=""
TWO_FACTOR_ISSUER="ULU Online School"
ADMIN_SSO_ENABLED="false"
ADMIN_SSO_SHARED_SECRET=""
ADMIN_SSO_LOGIN_URL=""
LOGIN_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"

# Test runner / e2e defaults
CI=""
PLAYWRIGHT_BASE_URL="http://localhost:3000"
PLAYWRIGHT_REUSE_EXISTING_SERVER="false"
E2E_ADMIN_EMAIL="fixed.admin@uluglobalacademy.com"
E2E_PORTAL_PASSWORD="ChangeMe123!"
E2E_INITIAL_PASSWORD="C5InitialStudent123!"
E2E_ADMIN_REQUIRE_2FA="false"
E2E_LIVE_LESSON_URL="https://meet.google.com/math-visibility"

# Google Calendar / Meet integration
GOOGLE_CALENDAR_ENABLED="false"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_IMPERSONATED_USER_EMAIL=""
GOOGLE_TIMEZONE=Africa/Nairobi

# Reminder Jobs
# Used by GET /api/cron/automation (required in all environments).
CRON_SECRET="change-this-cron-secret"
# Used by POST /api/reminders/send-due.
REMINDER_CRON_TOKEN="change-this-reminder-token"
# Optional in local dev. If empty, WhatsApp reminders are skipped safely.
WHATSAPP_WEBHOOK_URL=""

# Local AI assist
# Only "mock" is supported locally. Real providers must be added behind review/approval workflows.
AI_PROVIDER="mock"

# Monitoring
SENTRY_ENABLED="false"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional in local dev. If empty, alerts return ALERT_WEBHOOK_NOT_CONFIGURED.
ALERT_WEBHOOK_URL=""
# Used by POST /api/alerts/test.
ALERT_TEST_TOKEN="change-this-alert-test-token"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="info@uluglobalacademy.com"
NEXT_PUBLIC_CONTACT_PHONE="+254 XXX XXX XXX"
NEXT_PUBLIC_CONTACT_WHATSAPP="+254 XXX XXX XXX"

# Seed defaults (safe local fixtures, not secrets)
SEED_LIVE_LESSON_URL="https://meet.google.com/"
SEED_HOMEWORK_CONTENT_URL="https://example.com/homework.pdf"
SEED_MATERIAL_FILE_URL="https://example.com/seeded-physics.pdf"
