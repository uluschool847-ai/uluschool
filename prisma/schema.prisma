generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW         @map("new")
  IN_PROGRESS @map("in_progress")
  CONVERTED   @map("converted")
  REJECTED    @map("rejected")
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum StudentLearningStatus {
  TRIAL
  ACTIVE
  PAUSED
  INACTIVE
}

enum ClassGroupStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LessonStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum MeetingProvider {
  GOOGLE_MEET
  MANUAL_URL
}

enum AvailabilitySlotStatus {
  ACTIVE
  INACTIVE
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

enum ReminderDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PerformanceLevel {
  EXCELLENT
  GOOD
  STRUGGLING
}

model Enquiry {
  id                 String        @id @default(cuid())
  referenceId        String?       @unique
  studentName        String
  ageYearLevel       String
  subjects           String[]
  curriculumLevelId  String
  curriculumLevel    Level         @relation(fields: [curriculumLevelId], references: [id], onDelete: Restrict)
  parentGuardianName String
  email              String
  phoneWhatsapp      String
  preferredSchedule  String
  additionalNotes    String?
  status             EnquiryStatus @default(NEW)
  adminNotes         String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  referrer           String?
  convertedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  managerTasks ManagerTask[]
  notes        EnquiryNote[]
  timeline     EnquiryTimelineEvent[]

  @@index([status, createdAt])
  @@index([curriculumLevelId])
  @@index([utmSource, createdAt])
}

model ContactLead {
  id            String        @id @default(cuid())
  referenceId   String?       @unique
  fullName      String
  email         String
  phoneWhatsapp String?
  studentGrade  String?
  message       String
  status        EnquiryStatus @default(NEW)
  adminNotes    String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrer      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  notes         ContactLeadNote[]
  timeline      ContactLeadTimelineEvent[]

  @@index([status, createdAt])
  @@index([utmSource, createdAt])
}

model EnquiryNote {
  id        String   @id @default(cuid())
  entityId  String
  enquiry   Enquiry  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([authorId, createdAt])
}

model EnquiryTimelineEvent {
  id        String   @id @default(cuid())
  entityId  String
  enquiry   Enquiry  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actorId   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([actorId, createdAt])
}

model ContactLeadNote {
  id        String      @id @default(cuid())
  leadId    String
  lead      ContactLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime    @default(now())

  @@index([leadId, createdAt])
  @@index([authorId, createdAt])
}

model ContactLeadTimelineEvent {
  id        String      @id @default(cuid())
  leadId    String
  lead      ContactLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actorId   String
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

model AppUser {
  id                   String   @id @default(cuid())
  email                String   @unique
  fullName             String
  role                 UserRole
  passwordHash         String
  phoneWhatsapp        String?
  isActive             Boolean  @default(true)
  learningStatus       StudentLearningStatus?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  scheduledAsTeacher ScheduledClass[] @relation("TeacherScheduledClasses")
  classGroupsAsTeacher ClassGroup[]   @relation("TeacherClassGroups")
  availabilityRules TeacherAvailabilityRule[]
  unavailablePeriods TeacherUnavailablePeriod[]
  adminAuditLogs     AdminAuditLog[]

  // Educational Model Relations
  children           AppUser[]          @relation("ParentChildren")
  parents            AppUser[]          @relation("ParentChildren")
  enrolledClasses    ScheduledClass[]   @relation("ClassEnrollments")
  enrolledClassGroups ClassGroup[]      @relation("ClassGroupEnrollments")

  // CMS Relations
  blogPosts BlogPost[]

  // Dashboard Relations
  submissions          Submission[]
  studentProgresses    StudentProgress[] @relation("StudentProgressStudent")
  teacherProgresses    StudentProgress[] @relation("StudentProgressTeacher")
  courseMaterials      CourseMaterial[]
  cabinetTeacher       Teacher?         @relation("TeacherCabinetAccess")

  // Automation Relations
  assignedTasks ManagerTask[]

  // BI Relations
  subscriptions StudentSubscription[]
  payments      PaymentTransaction[]
}

model ScheduledClass {
  id                    String       @id @default(cuid())
  title                 String
  description           String?
  startAt               DateTime
  endAt                 DateTime
  timezone              String?
  status                LessonStatus @default(SCHEDULED)
  liveLessonUrl         String?
  meetingProvider       MeetingProvider @default(GOOGLE_MEET)
  googleCalendarEventId String?
  googleMeetSpaceName   String?
  meetingCreatedAt      DateTime?
  meetingUpdatedAt      DateTime?
  teacherId             String?
  teacher               AppUser?     @relation("TeacherScheduledClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId             String?
  subject               Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classGroupId          String?
  classGroup            ClassGroup?  @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  students              AppUser[]    @relation("ClassEnrollments")
  reminderMinutesBefore Int          @default(60)
  cancelledAt           DateTime?
  cancelReason          String?
  completedAt           DateTime?
  rescheduledFromId     String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  reminders       ReminderLog[]
  assignments     Assignment[]
  courseMaterials CourseMaterial[]

  @@index([startAt])
  @@index([teacherId, startAt])
  @@index([subjectId])
  @@index([status, startAt])
  @@index([classGroupId, startAt])
}

model TeacherAvailabilityRule {
  id        String                 @id @default(cuid())
  teacherId String
  teacher   AppUser                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  timezone  String                 @default("Europe/Kiev")
  status    AvailabilitySlotStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([teacherId, weekday, status])
}

model TeacherUnavailablePeriod {
  id        String   @id @default(cuid())
  teacherId String
  teacher   AppUser  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, startAt, endAt])
}

model ClassGroup {
  id          String           @id @default(cuid())
  name        String
  description String?
  subjectId   String?
  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  levelId     String?
  level       Level?           @relation(fields: [levelId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     AppUser?         @relation("TeacherClassGroups", fields: [teacherId], references: [id], onDelete: SetNull)
  status      ClassGroupStatus @default(ACTIVE)
  capacity    Int?
  startDate   DateTime?
  endDate     DateTime?
  students    AppUser[]        @relation("ClassGroupEnrollments")
  lessons     ScheduledClass[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, name])
  @@index([teacherId])
  @@index([subjectId])
  @@index([levelId])
}

model ReminderLog {
  id                  String                 @id @default(cuid())
  scheduledClassId    String
  scheduledClass      ScheduledClass         @relation(fields: [scheduledClassId], references: [id], onDelete: Cascade)
  recipientUserId     String
  recipientEmail      String
  channel             ReminderChannel
  status              ReminderDeliveryStatus @default(SENT)
  details             String?
  reminderWindowStart DateTime?
  reminderWindowEnd   DateTime?
  createdAt           DateTime               @default(now())

  @@unique([scheduledClassId, recipientUserId, channel, reminderWindowStart, reminderWindowEnd])
  @@index([scheduledClassId, recipientUserId, channel, createdAt])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  adminUserId   String?
  adminUser     AppUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorId       String
  actorEmail    String?
  actorFullName String?
  actorRole     String?
  action        String
  targetType    String
  targetId      String?
  before        Json?
  after         Json?
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model Teacher {
  id              String           @id @default(cuid())
  fullName        String
  title           String
  bio             String
  photoUrl        String?
  cabinetUserId   String?          @unique
  cabinetUser     AppUser?         @relation("TeacherCabinetAccess", fields: [cabinetUserId], references: [id], onDelete: SetNull)
  displayOrder    Int              @default(0)
  yearsExperience Int?
  isVetted        Boolean          @default(true)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  teacherSubjects TeacherSubject[]
  testimonials    Testimonial[]
}

model Testimonial {
  id           String   @id @default(cuid())
  studentName  String
  guardianName String?
  quote        String
  levelLabel   String
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levelSubjects   LevelSubject[]
  teacherSubjects TeacherSubject[]
  studentProgress StudentProgress[]
  scheduledClasses ScheduledClass[]
  classGroups      ClassGroup[]

  @@index([isActive, priority, name])
}

model Level {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  enquiries     Enquiry[]
  levelSubjects LevelSubject[]
  classGroups   ClassGroup[]
}

model LevelSubject {
  levelId   String
  subjectId String
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([levelId, subjectId])
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

// ==========================================
// NEW MODELS: CMS (Content Management)
// ==========================================

model PageContent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  authorId    String
  author      AppUser   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

model FaqItem {
  id           String   @id @default(cuid())
  category     String
  question     String
  answer       String
  status       String   @default("published")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, displayOrder])
  @@index([status, displayOrder, createdAt])
}

// ==========================================
// NEW MODELS: Dashboards v2
// ==========================================

model CourseMaterial {
  id               String         @id @default(uuid())
  title            String
  description      String?
  fileUrl          String
  scheduledClassId String
  scheduledClass   ScheduledClass @relation(fields: [scheduledClassId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          AppUser        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  attachments      Attachment[]

  @@index([scheduledClassId])
  @@index([teacherId])
}

model Assignment {
  id               String               @id @default(cuid())
  title            String
  description      String
  dueDate          DateTime
  scheduledClassId String
  subjectId        String?
  teacherId        String
  archivedAt       DateTime?
  scheduledClass   ScheduledClass       @relation(fields: [scheduledClassId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  submissions      Submission[]

  @@index([scheduledClassId])
  @@index([teacherId, scheduledClassId, archivedAt])
  @@index([dueDate])
}

model Submission {
  id           String     @id @default(cuid())
  studentId    String
  student      AppUser    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  contentUrl   String
  grade        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attachments  Attachment[]

  @@unique([studentId, assignmentId])
  @@index([assignmentId])
}

model Attachment {
  id               String          @id @default(cuid())
  filename         String
  storageKey       String
  mimeType         String
  size             Int
  submissionId     String?
  submission       Submission?     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  courseMaterialId String?
  courseMaterial   CourseMaterial? @relation(fields: [courseMaterialId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([submissionId])
  @@index([courseMaterialId])
  @@index([storageKey])
}

model StudentProgress {
  id           String   @id @default(cuid())
  studentId    String
  student      AppUser  @relation("StudentProgressStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      AppUser  @relation("StudentProgressTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel   PerformanceLevel
  teacherNotes String
  recordedAt   DateTime @default(now())

  @@index([studentId, subjectId])
  @@index([teacherId, studentId, subjectId])
}

// ==========================================
// NEW MODELS: Process Automation & CRM
// ==========================================

model ManagerTask {
  id               String     @id @default(cuid())
  title            String
  description      String
  assignedToId     String?
  assignedTo       AppUser?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate          DateTime
  status           TaskStatus @default(PENDING)
  relatedEnquiryId String?
  relatedEnquiry   Enquiry?   @relation(fields: [relatedEnquiryId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([assignedToId, status])
  @@index([dueDate])
}

// ==========================================
// NEW MODELS: BI Dashboards & Payments
// ==========================================

model StudentSubscription {
  id        String               @id @default(cuid())
  studentId String
  student   AppUser              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planName  String
  status    SubscriptionStatus   @default(ACTIVE)
  startDate DateTime             @default(now())
  endDate   DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  payments  PaymentTransaction[]

  @@index([studentId, status])
}

model PaymentTransaction {
  id             String               @id @default(cuid())
  subscriptionId String?
  subscription   StudentSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  studentId      String
  student        AppUser              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String               @default("USD")
  status         PaymentStatus        @default(PENDING)
  paymentDate    DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([studentId])
  @@index([status, paymentDate])
}
