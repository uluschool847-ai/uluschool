{
  "name": "ulu-school",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && next build",
    "env:check": "tsx scripts/check-production-env.ts",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts",
    "prestart": "npm run env:check",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:standard && npm run test:e2e:storage && npm run test:e2e:initial-admin-2fa",
    "test:e2e:focused": "node scripts/playwright-test.mjs --isolated-server",
    "test:e2e:standard": "node scripts/playwright-test.mjs --isolated-server --standard-partition",
    "test:e2e:storage": "node scripts/playwright-test.mjs --isolated-server --storage-partition e2e/portals/admin-teachers.spec.ts e2e/portals/teacher-academics.spec.ts e2e/portals/teacher-materials.spec.ts",
    "test:e2e:initial-admin-2fa": "node scripts/playwright-test.mjs --isolated-server --initial-admin-2fa-partition e2e/portals/initial-admin-2fa.spec.ts",
    "test:e2e:release": "npm run test:e2e:standard && npm run test:e2e:storage && npm run test:e2e:initial-admin-2fa",
    "qa:admin-smoke": "node scripts/admin-smoke.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:production": "tsx prisma/bootstrap-production.ts",
    "db:reset": "prisma migrate reset --force",
    "db:clean": "prisma generate && prisma db push --force-reset && npm run db:seed",
    "db:verify": "tsx prisma/verify-db.ts",
    "db:setup": "npm run db:generate && npm run db:reset && npm run db:verify",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.65.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.20",
    "next-themes": "^0.4.4",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "prisma": "^5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saxes": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "yaml": "^2.9.0"
  }
}
